---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GiftCard from "../../components/GiftCard.astro";
import GiftFilters from "../../components/GiftFilters.tsx";
import NameForm from "../../components/NameForm.tsx";
import ReservationRecovery from "../../components/ReservationRecovery.tsx";
import { getCurrentRecoveryCode } from "../../lib/reservations";
import { getWishlist, isWishlistId, sortGifts } from "../../data/wishlists";

// Listen gjesten ikke har tilgang til (eller som ikke finnes), sendes
// tilbake til gjestens egen liste.
const requested = Astro.params.liste;
if (!isWishlistId(requested) || !Astro.locals.wishlists.includes(requested)) {
  return Astro.redirect("/onskeliste");
}

const wishlist = getWishlist(requested);
const myWishlists = Astro.locals.wishlists.map(getWishlist);
const sortedGifts = sortGifts(wishlist.gifts);
const recoveryCode = await getCurrentRecoveryCode(Astro.cookies);
---

<BaseLayout title={wishlist.pageTitle} theme={wishlist.theme}>
  <main>
    {
      myWishlists.length > 1 && (
        <nav class="wishlist-switcher" aria-label="Ønskelister">
          {myWishlists.map((list) => (
            <a
              href={`/onskeliste/${list.id}`}
              aria-current={list.id === wishlist.id ? "page" : undefined}
            >
              {list.name}
            </a>
          ))}
        </nav>
      )
    }

    <h1>{wishlist.heading}</h1>
    <p class="muted">{wishlist.intro}</p>

    {/* client:only: navnet leses fra localStorage og finnes ikke ved SSR */}
    <NameForm client:only="react" />
    <ReservationRecovery client:load initialRecoveryCode={recoveryCode} />

    {
      sortedGifts.length === 0 ? (
        <p class="empty-list">Ønskene er ikke lagt inn ennå. Kom gjerne tilbake litt senere!</p>
      ) : (
        <>
          <GiftFilters client:load filters={wishlist.filters} />

          <div class="gift-list">
            {sortedGifts.map((gift) => <GiftCard gift={gift} />)}
          </div>
        </>
      )
    }

    <p class="other-wishlist muted">
      Har du fått passord til en annen ønskeliste?{" "}
      <a href="/?nytt-passord#finn-onskeliste">Skriv det inn her</a>.
    </p>
  </main>
</BaseLayout>

<style>
  .gift-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-block-start: 1rem;
  }

  @media (min-width: 40rem) {
    .gift-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .wishlist-switcher {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-end: 0.5rem;
  }

  .wishlist-switcher a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    padding: 0.25rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
  }

  .wishlist-switcher a[aria-current="page"] {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  .empty-list {
    margin-block: 2rem;
    padding: 1.5rem 1rem;
    text-align: center;
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
  }

  .other-wishlist {
    margin-block-start: 2.5rem;
    font-size: 0.9rem;
    text-align: center;
  }
</style>

<style is:global>
  /* Stiler for GiftFilters-øya (React-komponenter kan ikke bruke
     Astro-scoped CSS, så de deles her via layoutens tokens). */
  .gift-filters {
    margin-block-start: 0.5rem;
  }

  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-btn {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    font-weight: 500;
  }

  .filter-btn:hover {
    background: rgba(61, 46, 29, 0.06);
  }

  .filter-btn.is-active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
    font-weight: 600;
  }

  .filter-btn.is-active:hover {
    background: var(--color-primary-strong);
  }

  .filter-status {
    min-height: 1.5rem;
    margin-block: 0.5rem 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  /* Stiler for NameForm-øya (MVP.md §8) */
  .name-form {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-block: 1rem;
    padding: 0.75rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .name-form label {
    font-weight: 600;
  }

  .name-form-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .name-form-row input {
    flex: 1 1 12rem;
    max-width: 22rem;
  }

  .name-form-status {
    margin: 0;
    font-size: 0.9rem;
  }

  .reservation-recovery {
    margin-block: 1rem;
  }

  .reservation-recovery-code {
    padding: 0.75rem 1rem;
    background: #fff7d6;
    border: 1px solid #c88a00;
    border-radius: var(--radius);
  }

  .reservation-recovery-code p {
    margin: 0.25rem 0;
  }

  .reservation-recovery-code code {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .reservation-recovery-code-value {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0.25rem 0;
  }

  .reservation-recovery-copy {
    display: inline-grid;
    width: 2rem;
    height: 2rem;
    padding: 0;
    place-items: center;
    color: var(--color-text);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
  }

  .reservation-recovery-copy:hover {
    background: rgba(61, 46, 29, 0.06);
  }

  .reservation-recovery-copy svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .reservation-recovery-copy-error {
    color: #9b2c13;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .reservation-recovery summary {
    cursor: pointer;
    color: var(--color-text-muted);
  }

  .reservation-recovery form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin-block-start: 0.75rem;
  }

  .reservation-recovery-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    width: 100%;
  }

  .reservation-recovery input {
    flex: 1 1 12rem;
    max-width: 22rem;
    min-width: 0;
  }

  .reservation-recovery-message {
    margin: 0;
  }
</style>
